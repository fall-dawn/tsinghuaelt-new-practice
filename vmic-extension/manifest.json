{
  "manifest_version": 3,
  "name": "清英在线 · VMIC 示范音频适配版",
  "version": "1.2.9",
  "description": "基于 ckckh2023/TsingHuaelt-VMIC 的本地适配：示范音频载入确认、题组绑定和空音频停止。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "assets/icon.png",
    "32": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "background": {
    "service_worker": "background/background.js"
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "VMIC - 虚拟麦克风",
    "default_icon": {
      "16": "assets/icon.png",
      "32": "assets/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.tsinghuaelt.com/*"],
      "js": ["content/content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.tsinghuaelt.com/*"],
      "js": ["content/content-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://www.tsinghuaelt.com/*"],
      "js": ["content/content-capture-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.tsinghuaelt.com/*"],
      "js": ["content/content-capture.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
